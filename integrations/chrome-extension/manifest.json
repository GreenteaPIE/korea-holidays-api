{
  "manifest_version": 3,
  "name": "한국 공휴일 D-day",
  "short_name": "공휴일 D-day",
  "version": "1.0.0",
  "description": "다음 공휴일까지 남은 날을 툴바에 표시하고, 대체공휴일·임시공휴일까지 반영한 이번 달 달력을 보여줍니다.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "한국 공휴일 D-day" },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://korea-holidays-api.greenteapie2023.workers.dev/*"]
}
