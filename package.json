{
  "name": "korea-holidays",
  "version": "0.3.0",
  "description": "대한민국 공휴일·영업일 계산 라이브러리 & Open API — 대체공휴일·임시공휴일·연차·급여일·MCP 지원",
  "keywords": [
    "korea",
    "holidays",
    "public-holidays",
    "business-days",
    "rest-api",
    "open-api",
    "hono",
    "cloudflare-workers",
    "korean",
    "calendar",
    "ical",
    "vacation",
    "annual-leave",
    "payday",
    "mcp"
  ],
  "homepage": "https://github.com/GreenteaPIE/korea-holidays-api#readme",
  "bugs": {
    "url": "https://github.com/GreenteaPIE/korea-holidays-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreenteaPIE/korea-holidays-api.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "verify-data": "node scripts/verify-holidays.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "export:python": "node scripts/export-python-data.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "hono": "^4.13.14",
    "pretendard": "^1.3.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0",
    "zod": "^4.6.7"
  }
}
